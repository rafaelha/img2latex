# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# OpenAI API key — used server-side only by app/api/convert-image/route.ts.
# Create one at https://platform.openai.com/api-keys
# The key needs the "Model capabilities → Chat completions" (model.request) scope.
OPENAI_API_KEY=sk-your-key-here
